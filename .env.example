# WorkBuddy 本地网关地址（OpenAI 兼容接口，末尾保留 /v1）
# 默认端口 8000 适用于任意 OpenAI 兼容网关；
# 使用 Ianzhyh/workbuddy-to-dsh 本地桥时改为 http://127.0.0.1:8790/v1
WORKBUDDY_BASE_URL=http://127.0.0.1:8000/v1

# 方式一：直接填写网关 API Key
WORKBUDDY_API_KEY=your-workbuddy-api-key

# 方式二：留空上面的 Key，改为指向本地桥令牌文件（推荐，令牌不会被复制进项目）
# Windows 默认：C:/Users/<用户名>/.workbuddy-bridge/bridge-token
# WORKBUDDY_API_KEY_FILE=C:/Users/your-name/.workbuddy-bridge/bridge-token

# 网关中可用的模型名称
# deepseek-v4.1-flash / deepseek-v4-pro / glm-5.3（workbuddy-to-dsh 桥）
WORKBUDDY_MODEL_NAME=workbuddy
